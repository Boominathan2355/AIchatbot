PORT=3001
NODE_ENV=development

# Provider key used when the client does not supply its own
GEMINI_API_KEY=
OPENAI_API_KEY=

# Required. No default - the app refuses to start without it.
MONGODB_URI=mongodb://localhost:27017/gemini-chat

# Required in production. Generate with: openssl rand -hex 32
# In development a random per-process secret is used if unset.
JWT_SECRET=

# Comma-separated list of origins allowed to call the API.
# Localhost is always allowed in development.
FRONTEND_URL=http://localhost:5173

# Outer boundary for ALL local file and git access. Leave empty to disable
# those endpoints entirely. The per-user "Allowed Path" in Settings can only
# narrow this directory, never escape it.
ALLOWED_BASE_PATH=

MAX_FILE_SIZE=20971520
ALLOWED_FILE_TYPES=pdf,docx,txt,png,jpg,jpeg,webp

# Attachments larger than this are stored as metadata only, keeping
# conversation documents under MongoDB's 16MB limit.
MAX_STORED_ATTACHMENT_BYTES=1048576
